# Copy this file to .env at the repository root only when developing the launcher itself;
# src-tauri/build.rs loads .env over these template defaults and .env is git-ignored.
# No credential is committed: the CurseForge API key is injected at build time from
# WTUMCL_CURSEFORGE_API_KEY below and embedded into the binary, so the variable must be
# present when building the launcher, not when running it. A build without it still
# compiles, but CurseForge browsing then reports a missing key.
# Wrap the value in single quotes so its dollar signs survive.
WTUMCL_CURSEFORGE_API_KEY = ''

# Project custom dev toolbar
NEXT_PUBLIC_DEV_TOOLBAR = 'true'
