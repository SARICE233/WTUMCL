# Copy this file to .env at the repository root only when developing the launcher itself;
# src-tauri/build.rs loads .env over these template defaults and .env is git-ignored.
# WTUMCL ships a working CurseForge credential, so a normal install needs no configuration.
# WTUMCL_CURSEFORGE_API_KEY below is an optional developer-only override for testing keys.
# Keys look like $2a$10$...; wrap the value in single quotes so its dollar signs survive.
WTUMCL_CURSEFORGE_API_KEY = ''

# Project custom dev toolbar
NEXT_PUBLIC_DEV_TOOLBAR = 'true'
