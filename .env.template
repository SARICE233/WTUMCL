# Copy this file to .env at the repository root and fill the values in; src-tauri/build.rs
# loads .env over these template defaults, and .env is git-ignored so the key stays local.
# The key is only needed to browse CurseForge (Modrinth works without it). Apply for one at
# https://support.curseforge.com/support/solutions/articles/9000208346-about-the-curseforge-api-and-how-to-apply-for-a-key
# Leaving it empty is reported as an unset CurseForge API key, not as a connection failure.
# As `$` frequently appears in CurseForge API keys, wrap the value in single quotes.
# When using double quotes, escape each `$` as `\$`.
WTUMCL_CURSEFORGE_API_KEY = ''

# Project custom dev toolbar
NEXT_PUBLIC_DEV_TOOLBAR = 'true'
